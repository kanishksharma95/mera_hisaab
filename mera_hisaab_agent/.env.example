# Google Gemini API key (Required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Path to the Mera Hisaab Django project root directory (Required)
MERA_HISAAB_PATH=c:/Users/Kanishak/Desktop/mera_hisaab

# Django settings module (Default: config.settings.dev)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Shop/Business ID to scope all queries and actions (Required)
BUSINESS_ID=1

# Real User ID representing the agent actor (Required)
AGENT_ACTOR_USER_ID=1

