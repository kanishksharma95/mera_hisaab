# Mera Hisaab environment configuration.
# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL is the target DB) ---
POSTGRES_DB=mera_hisaab
POSTGRES_USER=mera_hisaab
POSTGRES_PASSWORD=mera_hisaab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local dev without Postgres? Set this to 1 to use a SQLite file instead.
USE_SQLITE=0

# --- Media storage (Cloudflare R2 / S3) ---
# Leave R2_BUCKET empty for local filesystem storage (dev default).
# Set these in production to store user uploads on Cloudflare R2 (10 GB free,
# zero egress). Create a bucket + API token at Cloudflare -> R2.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Optional public CDN domain for serving media (leave blank to use the endpoint):
R2_CUSTOM_DOMAIN=

# --- Razorpay payment gateway (100% Free account, no maintenance fee) ---
# Get TEST keys (rzp_test_...) or LIVE keys (rzp_live_...) from https://dashboard.razorpay.com (Settings > API Keys).
# KEY_ID is exposed to the browser for checkout; SECRET and WEBHOOK_SECRET stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to configure on Razorpay Dashboard: https://<your-domain>/payments/webhook/razorpay/
# Secret that you choose on Razorpay dashboard:
RAZORPAY_WEBHOOK_SECRET=

# --- Cache / rate-limiting (optional) ---
# Set a Redis URL in production so rate-limit + axes counters are shared across
# workers. Leave blank for local in-memory cache (dev).
REDIS_URL=

# --- Production CSRF & Host origins ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost

# --- Email Setup (Password Reset & Notifications) ---
# RECOMMENDED for Render/cloud hosts: Brevo (HTTP API, 300 free emails/day).
# Hosts like Render's free tier BLOCK outbound SMTP ports (25/465/587), so the
# SMTP options below time out there. Brevo sends over HTTPS and just works.
# No domain needed: verify a single sender email (e.g. your Gmail) in Brevo.
# Sign up free at https://brevo.com -> SMTP & API -> API Keys -> Generate.
# If BREVO_API_KEY is set, it takes priority over the SMTP settings below.
# DEFAULT_FROM_EMAIL must be the exact sender you verified in Brevo.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Mera Hisaab <yourname@gmail.com>

# --- SMTP alternatives (fine locally; blocked on Render free tier) ---
# Option A: Brevo SMTP (works locally, NOT on Render free tier)
# Sign up free at https://brevo.com -> SMTP & API -> Generate Key
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@domain.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Mera Hisaab <no-reply@yourdomain.com>

# Option B: Free Gmail SMTP
# (Generate App Password at: https://myaccount.google.com/apppasswords)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=yourname@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Mera Hisaab <yourname@gmail.com>

# Preferred (leave blank to fall back to SMTP below):
BREVO_API_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Mera Hisaab <no-reply@merahisaab.app>

