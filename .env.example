# Mera Hisaab environment configuration.
# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL is the target DB) ---
POSTGRES_DB=mera_hisaab
POSTGRES_USER=mera_hisaab
POSTGRES_PASSWORD=mera_hisaab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local dev without Postgres? Set this to 1 to use a SQLite file instead.
USE_SQLITE=0

# --- Razorpay payment gateway ---
# Get TEST keys from https://dashboard.razorpay.com (Settings > API Keys).
# Test keys start with rzp_test_. KEY_ID is exposed to the browser; the SECRET
# and WEBHOOK_SECRET must stay server-side only. Leave blank to disable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the secret you configure on the Razorpay webhook (Settings >
# Webhooks) pointing at https://<your-host>/payments/webhook/razorpay/
RAZORPAY_WEBHOOK_SECRET=

# --- Production CSRF / email (used by config.settings.prod) ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.merahisaab.example
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
