# Mera Hisaab environment configuration.
# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL is the target DB) ---
POSTGRES_DB=mera_hisaab
POSTGRES_USER=mera_hisaab
POSTGRES_PASSWORD=mera_hisaab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local dev without Postgres? Set this to 1 to use a SQLite file instead.
USE_SQLITE=0

# --- Razorpay payment gateway (100% Free account, no maintenance fee) ---
# Get TEST keys (rzp_test_...) or LIVE keys (rzp_live_...) from https://dashboard.razorpay.com (Settings > API Keys).
# KEY_ID is exposed to the browser for checkout; SECRET and WEBHOOK_SECRET stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to configure on Razorpay Dashboard: https://<your-domain>/payments/webhook/razorpay/
# Secret that you choose on Razorpay dashboard:
RAZORPAY_WEBHOOK_SECRET=

# --- Production CSRF & Host origins ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost

# --- 100% FREE Email (SMTP) Setup (Password Reset & Notifications) ---
# Option A: Brevo / Sendinblue (Recommended - 300 free emails/day)
# Sign up free at https://brevo.com -> SMTP & API -> Generate Key
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@domain.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Mera Hisaab <no-reply@yourdomain.com>

# Option B: Free Gmail SMTP
# (Generate App Password at: https://myaccount.google.com/apppasswords)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=yourname@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Mera Hisaab <yourname@gmail.com>

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Mera Hisaab <no-reply@merahisaab.app>

